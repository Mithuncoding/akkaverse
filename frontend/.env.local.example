# ============================================================
# Akkaverse Frontend — environment template
# ============================================================
# NEXT_PUBLIC_* values are exposed to the browser by design.
# Use only Supabase's public publishable key. Never put a
# service-role key, database password, or JWT secret here.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only NVIDIA key for live Akka answers (optional).
NVIDIA_API_KEY=
NIM_MODEL=meta/llama-3.3-70b-instruct
