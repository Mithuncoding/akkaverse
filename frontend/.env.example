# ─────────────────────────────────────────────────────────────────────────────
# Akkaverse — environment variables
# Copy this file to `.env.local` and fill in your values. `.env.local` is
# gitignored and is never committed.
# ─────────────────────────────────────────────────────────────────────────────

# NVIDIA NIM API key from NVIDIA Build (https://build.nvidia.com).
# SERVER-ONLY — no NEXT_PUBLIC prefix, so the key never reaches the browser.
# The app works fully without it (curated knowledge base + seeded answers);
# set it to enable richer, grounded, streamed AI answers from Akka.
NVIDIA_API_KEY=

# Optional model overrides. These defaults are verified on NVIDIA Build's
# free-tier catalog. Some larger catalog models are account/region dependent.
NIM_MODEL=meta/llama-3.1-8b-instruct
NIM_KANNADA_MODEL=meta/llama-3.1-8b-instruct
NIM_FALLBACK_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Optional endpoint override (OpenAI-compatible NIM base URL).
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Supabase (free authentication, Postgres, realtime, and storage).
# Dashboard -> Connect -> Next.js. These are public browser credentials;
# security comes from Row Level Security policies, not hiding the anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
